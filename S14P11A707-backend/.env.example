# --- Keycloak (필수) ---
# OIDC Issuer URI
# 예)
#   KEYCLOAK_ISSUER_URI=https://auth.bunnect.kr/realms/hongyeon
KEYCLOAK_ISSUER_URI=

# Keycloak Client (Public + PKCE)
# 예)
#   KEYCLOAK_CLIENT_ID=hongyeon-backend
KEYCLOAK_CLIENT_ID=

# --- Database (필수) ---
# 예: jdbc:postgresql://localhost:5432/s14p11a707
# - (권장) ECS environment (RDS 사용 시: endpoint/port/dbname 포함)
DB_URL=
# - (권장) ECS environment
DB_USERNAME=
# - (권장) SSM Parameter Store SecureString → ECS `secrets`로 주입
DB_PASSWORD=
# 예: org.postgresql.Driver
# - (권장) ECS environment
DB_DRIVER=

# 예: create-drop / update / validate
# - (권장) ECS environment
JPA_DDL_AUTO=

# --- SQL Init (선택) ---
# schema.sql 실행 여부: always / never / embedded
SQL_INIT_MODE=always

# --- Session Cookie (선택) ---
# 운영 HTTPS면 true 권장
# - (권장) ECS environment
SESSION_COOKIE_SECURE=false
# lax / none / strict
# - (권장) ECS environment
SESSION_COOKIE_SAME_SITE=lax

# --- Auth Redirect (선택) ---
# 로그인 완료 후 이동할 URL
# - 상대경로(백엔드 동일 origin): /swagger-ui/index.html
# - 절대 URL(프론트 origin): https://hongyeon.cloud-ip.cc/ 또는 http://localhost:5173/
APP_AUTH_DEFAULT_REDIRECT_URL=
#
# 절대 URL 리다이렉트를 허용할 origin allowlist (comma-separated)
# - 예) https://hongyeon.cloud-ip.cc,http://localhost:5173
APP_AUTH_ALLOWED_REDIRECT_ORIGINS=

# --- Scenario v2 Image (선택) ---
# google(기본): Google GenAI Imagen 기반 실제 이미지 생성
# placeholder: 더미 단색 PNG 생성(비용/속도/테스트용)
APP_SCENARIO_V2_IMAGE_GENERATOR=google
# 예) imagen-4.0-fast-generate-001 / imagen-4.0-generate-001 / imagen-4.0-ultra-generate-001
APP_SCENARIO_V2_IMAGE_MODEL=imagen-4.0-fast-generate-001
