# --- Cognito (필수) ---
# Cognito App Client ID (Public client 권장)
# - (권장) ECS environment
COGNITO_CLIENT_ID=

# Cognito OAuth2/OIDC 엔드포인트(Hosted UI 도메인 / User Pool 기반)
# - authorization/token/userInfo는 "Cognito 도메인" 기준
# - jwk-set은 "User Pool Issuer" 기준
#
# 예)
#   COGNITO_AUTHORIZATION_URI=https://<your-domain>.auth.<region>.amazoncognito.com/oauth2/authorize
#   COGNITO_TOKEN_URI=https://<your-domain>.auth.<region>.amazoncognito.com/oauth2/token
#   COGNITO_USER_INFO_URI=https://<your-domain>.auth.<region>.amazoncognito.com/oauth2/userInfo
#   COGNITO_JWK_SET_URI=https://cognito-idp.<region>.amazonaws.com/<userPoolId>/.well-known/jwks.json
# - (권장) ECS environment
COGNITO_AUTHORIZATION_URI=
COGNITO_TOKEN_URI=
COGNITO_USER_INFO_URI=
COGNITO_JWK_SET_URI=

# --- Database (필수) ---
# 예: jdbc:postgresql://localhost:5432/s14p11a707
# - (권장) ECS environment (RDS 사용 시: endpoint/port/dbname 포함)
DB_URL=
# - (권장) ECS environment
DB_USERNAME=
# - (권장) SSM Parameter Store SecureString → ECS `secrets`로 주입
DB_PASSWORD=
# 예: org.postgresql.Driver
# - (권장) ECS environment
DB_DRIVER=

# 예: create-drop / update / validate
# - (권장) ECS environment
JPA_DDL_AUTO=

# --- SQL Init (선택) ---
# schema.sql 실행 여부: always / never / embedded
SQL_INIT_MODE=always

# --- Session Cookie (선택) ---
# 운영 HTTPS면 true 권장
# - (권장) ECS environment
SESSION_COOKIE_SECURE=false
# lax / none / strict
# - (권장) ECS environment
SESSION_COOKIE_SAME_SITE=lax

# --- Auth Redirect (선택) ---
# 로그인 완료 후 이동할 URL
# - 상대경로(백엔드 동일 origin): /swagger-ui/index.html
# - 절대 URL(프론트 origin): https://hongyeon.cloud-ip.cc/ 또는 http://localhost:5173/
APP_AUTH_DEFAULT_REDIRECT_URL=
#
# 절대 URL 리다이렉트를 허용할 origin allowlist (comma-separated)
# - 예) https://hongyeon.cloud-ip.cc,http://localhost:5173
APP_AUTH_ALLOWED_REDIRECT_ORIGINS=
