# --- Keycloak (필수) ---
# OIDC Issuer URI
# 예)
#   KEYCLOAK_ISSUER_URI=https://auth.bunnect.kr/realms/hongyeon
KEYCLOAK_ISSUER_URI=

# Keycloak Client (Public + PKCE)
# 예)
#   KEYCLOAK_CLIENT_ID=hongyeon-backend
KEYCLOAK_CLIENT_ID=

# --- Database (필수) ---
# 예: jdbc:postgresql://localhost:5432/s14p11a707
# - (권장) ECS environment (RDS 사용 시: endpoint/port/dbname 포함)
DB_URL=
# - (권장) ECS environment
DB_USERNAME=
# - (권장) SSM Parameter Store SecureString → ECS `secrets`로 주입
DB_PASSWORD=
# 예: org.postgresql.Driver
# - (권장) ECS environment
DB_DRIVER=

# 예: create-drop / update / validate
# - (권장) ECS environment
JPA_DDL_AUTO=

# --- SQL Init (선택) ---
# schema.sql 실행 여부: always / never / embedded
SQL_INIT_MODE=always

# --- Session Cookie (선택) ---
# 운영 HTTPS면 true 권장
# - (권장) ECS environment
SESSION_COOKIE_SECURE=false
# lax / none / strict
# - (권장) ECS environment
SESSION_COOKIE_SAME_SITE=lax

# --- Auth Redirect (선택) ---
# 로그인 완료 후 이동할 URL
# - 상대경로(백엔드 동일 origin): /swagger-ui/index.html
# - 절대 URL(프론트 origin): https://hongyeon.cloud-ip.cc/ 또는 http://localhost:5173/
APP_AUTH_DEFAULT_REDIRECT_URL=
#
# 절대 URL 리다이렉트를 허용할 origin allowlist (comma-separated)
# - 예) https://hongyeon.cloud-ip.cc,http://localhost:5173
APP_AUTH_ALLOWED_REDIRECT_ORIGINS=

# --- Scenario v2 Image (선택) ---
# 예) imagen-4.0-fast-generate-001 / imagen-4.0-generate-001 / imagen-4.0-ultra-generate-001
APP_SCENARIO_V2_IMAGE_MODEL=imagen-4.0-fast-generate-001

# --- Vertex AI (선택) ---
# Gemini/Imagen을 Vertex AI로 호출하고 싶을 때 활성화.
# - APP_VERTEX_ACCESS_TOKEN은 OAuth2 access token(짧게 만료됨) 또는 빈 값(ADC 사용)을 허용
APP_VERTEX_ENABLED=false
# 예) my-gcp-project-id
APP_VERTEX_PROJECT_ID=
# 예) us-central1 (권장) / asia-northeast3
# - Vertex는 리전별로 사용 가능한 모델이 달라서, 특정 리전에서 `... Model ... not found(404)`가 날 수 있음
APP_VERTEX_LOCATION=us-central1
# 서비스 계정 키 JSON 경로
# - 예) file:/Users/me/sa.json
# - 예) /Users/me/sa.json
APP_VERTEX_CREDENTIALS_URI=
# OAuth2 access token (Bearer). 로컬 개발 편의용이며 만료되면 갱신 필요.
APP_VERTEX_ACCESS_TOKEN=

# --- GMS Chat API (선택) ---
# GMS 기반 채팅 모델 API
GMS_KEY=
